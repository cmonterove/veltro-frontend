{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "veltro-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "veltro-web-api",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_DEMO=0",
        "VELTRO_API_URL=http://localhost:4000",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "veltro-web-prod",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_DEMO=0",
        "VELTRO_API_URL=https://velion-console.desarrollodeproinf.com",
        "npm",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "veltro-web-design",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_DEMO=0",
        "VELTRO_API_URL=http://localhost:4000",
        "NEXT_DIST_DIR=.next-design",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3002"
      ],
      "port": 3002
    },
    {
      "name": "veltro-backend",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NODE_ENV=development",
        "PORT=4000",
        "DATABASE_URL=postgres://localhost:5432/veltro_dev",
        "AUTH_MODE=local",
        "STORAGE_MODE=local",
        "PUBLIC_API_URL=http://localhost:4000",
        "PUBLIC_WEB_URL=http://localhost:3000",
        "CORS_ORIGINS=http://localhost:3000,http://localhost:3002",
        "npm",
        "--prefix",
        "../veltro-backend",
        "run",
        "dev"
      ],
      "port": 4000
    },
    {
      "name": "veltro-backend-prod",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ../veltro-backend && npx tsx watch --env-file=.env src/server.ts"
      ],
      "port": 4000
    },
    {
      "name": "veltro-console",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../veltro-console",
        "run",
        "dev"
      ],
      "port": 3010
    },
    {
      "name": "veltro-landing",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "../veltro-landing",
        "run",
        "dev"
      ],
      "port": 3001
    },
    {
      "name": "veltro-design",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4600",
        "--directory",
        "../veltro-mobile/design"
      ],
      "port": 4600
    },
    {
      "name": "veltro-logos",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4610",
        "--directory",
        "logos"
      ],
      "port": 4610
    },
    {
      "name": "veltro-propuestas",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4620",
        "--directory",
        "propuestas"
      ],
      "port": 4620
    },
    {
      "name": "veltro-web-rediseno",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_PUBLIC_DEMO=0",
        "VELTRO_API_URL=http://localhost:4000",
        "NEXT_DIST_DIR=.next-rediseno",
        "npm",
        "run",
        "dev",
        "--",
        "-p",
        "3004"
      ],
      "port": 3004
    },
    {
      "name": "veltro-console-demo",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd ../veltro-console && NEXT_PUBLIC_DEMO=1 NEXT_DIST_DIR=.next-demo npx next dev --turbopack --port 3011"
      ],
      "port": 3011
    }
  ]
}
